<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only for development: lets the app talk to a Pearl server running on
	     your Mac (http://localhost:5050). Pearl's own server is https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Pearl's two faces, as on the web: Fraunces for display, Figtree for
	     text (ios/Pearl/Fonts, SIL Open Font License). -->
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces-Regular.ttf</string>
		<string>Fraunces-SemiBold.ttf</string>
		<string>Figtree-Regular.ttf</string>
		<string>Figtree-Medium.ttf</string>
		<string>Figtree-SemiBold.ttf</string>
		<string>Figtree-Bold.ttf</string>
	</array>
	<!-- O-04a: the system's Face ID prompt (THL-119). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock Pearl quickly and privately.</string>
	<!-- S-17: names from her contacts when she adds someone to a split. -->
	<key>NSContactsUsageDescription</key>
	<string>Find the people you split purchases with. Pearl only reads names, and only when you search.</string>
	<!-- pearl://reset?token=… opens A-07 "Choose a new password". -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mariapapadimitriou.pearl</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pearl</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
